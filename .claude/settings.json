{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Bash(./gradlew*)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(docker-compose *)",
      "Bash(docker compose *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Read(.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE '(rm -rf|DROP TABLE|DELETE FROM|TRUNCATE)'; then echo 'BLOCK: 위험한 명령이 차단되었습니다.' >&2; exit 1; fi"
          }
        ]
      }
    ]
  }
}
