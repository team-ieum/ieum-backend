# ============================================================
# ieum-backend 환경변수 예시 파일
# 실제 값으로 채운 후 .env 파일로 복사하여 사용하세요.
# cp .env.example .env
# ============================================================

# PostgreSQL
POSTGRES_PASSWORD=your_password_here

# MongoDB
MONGO_INITDB_ROOT_USERNAME=your_mongo_user_here
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password_here
